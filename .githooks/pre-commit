#!/bin/sh
# pre-commitフック。task本体が無くても動くよう uv を直接呼ぶ。
# 有効化: task setup_dev（= git config core.hooksPath .githooks）
set -e
# tests を含める（task lint/format と対象を一致）。mypy/bounds/userapi/test は
# 重いので hook では流さず `task ci` に任せる。
uv run --frozen ruff check SerialController tools tests
uv run --frozen ruff format --check SerialController tools tests
